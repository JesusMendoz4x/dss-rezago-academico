{
  "name": "dss-rezago-academico",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "data:generate": "node server/scripts/generate-fixtures.js",
    "data:check": "node server/scripts/generate-fixtures.js --check",
    "etl": "node server/scripts/run-etl.js",
    "etl:load": "node server/scripts/run-etl.js --load",
    "test:etl": "node --test server/tests/etl.test.js",
    "doctor": "node scripts/check-installation.mjs",
    "predev": "node scripts/check-installation.mjs",
    "test:indicators": "node --test server/tests/indicators.test.js",
    "test:risk": "node --test server/tests/risk.test.js",
    "test:compare": "node --test server/tests/compare.test.js",
    "test:capacity": "node --test client/tests/attention-plan.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
